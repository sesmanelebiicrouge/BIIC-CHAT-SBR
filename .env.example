# ========================================
# SUPABASE + CELCOM CONFIGURATION
# ========================================

# Supabase Project URL
SUPABASE_URL=https://your-project.supabase.co

# Supabase Public/Anon Key (client-side safe)
SUPABASE_PUBLISHABLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# Supabase Service Role Key (SERVER-SIDE ONLY - NEVER expose in app)
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ========================================
# CELCOM SMS CONFIGURATION (REPLACES TWILIO)
# ========================================
# Obtain from: https://api.celcom.com.my
# After signing up for Celcom SMS API account

CELCOM_API_KEY=celcom_key_xxxxxxxxxxxxxxxxxxxxxxxx
CELCOM_API_ENDPOINT=https://api.celcom.com.my/sms/send

# ========================================
# FLUTTER BUILD CONFIGURATION
# ========================================

FLUTTER_ENV=development
# Options: development, staging, production

# ========================================
# OPTIONAL: FIREBASE CONFIGURATION
# ========================================
# Only if using Firebase (Analytics, Notifications, etc.)

FIREBASE_PROJECT_ID=your_firebase_project
FIREBASE_API_KEY=your_firebase_api_key
FIREBASE_MESSAGING_SENDER_ID=your_sender_id

# ========================================
# USAGE IN FLUTTER
# ========================================
# Build with dart-define flags:
#
# flutter run \
#   --dart-define=SUPABASE_URL=https://your-project.supabase.co \
#   --dart-define=SUPABASE_PUBLISHABLE_KEY=your_anon_key \
#   --dart-define=CELCOM_API_KEY=your_celcom_api_key \
#   --dart-define=CELCOM_API_ENDPOINT=https://api.celcom.com.my/sms/send \
#   --dart-define=FLUTTER_ENV=development
#
# OR use flutter_dotenv to load from .env file
#
# In main.dart:
#   await dotenv.load(fileName: ".env");
#   final celcomService = CelcomOtpService(
#     supabase: Supabase.instance.client,
#     celcomApiKey: dotenv.env['CELCOM_API_KEY']!,
#     celcomApiEndpoint: dotenv.env['CELCOM_API_ENDPOINT']!,
#   );
