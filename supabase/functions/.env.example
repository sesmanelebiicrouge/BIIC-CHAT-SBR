# NEVER commit real values to Git.
# Production values belong in Supabase Edge Function Secrets.

ORANGE_SMS_CLIENT_ID=
ORANGE_SMS_CLIENT_SECRET=

# Default Côte d'Ivoire sender supplied by Orange.
# Keep the Orange CI sender address below.
ORANGE_SMS_SENDER=tel:+2250000

# Optional: set only after Orange whitelists the sender name.
ORANGE_SMS_SENDER_NAME=

# Generate/configure this from Supabase Auth > Hooks > Send SMS.
SEND_SMS_HOOK_SECRET=
